---
import { issuesUrl, releasesUrl, repoUrl } from '../lib/release';

const year = new Date().getFullYear();
---
<footer class="footer">
    <div class="container">
        <div class="footer-grid">
            <div>
                <h4>Spinclip</h4>
                <p>Promo videos for music releases, from a cover and a song. Free, with its source on GitHub. Built with Flutter and FFmpeg by BandPass Records.</p>
            </div>
            <div>
                <h4>Resources</h4>
                <ul>
                    <li><a href="/guide/overview/">User guide</a></li>
                    <li><a href="/changelog/">What's new</a></li>
                    <li><a href={releasesUrl}>All releases</a></li>
                    <li><a href={issuesUrl}>Report an issue</a></li>
                </ul>
            </div>
            <div>
                <h4>Also from BandPass</h4>
                <ul>
                    <li><a href="https://dpm.bandpassrecords.com">DAW Project Manager</a></li>
                    <li><a href={repoUrl}>Spinclip on GitHub</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; {year} BandPass Records. Spinclip ships FFmpeg as a separate program under its GPLv3 license. FFmpeg is a trademark of Fabrice Bellard; platform names are trademarks of their owners.</p>
        </div>
    </div>
</footer>
